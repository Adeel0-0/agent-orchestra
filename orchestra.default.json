{
  "workspace_root": ".",
  "orchestra_dir": ".orchestra",
  "coordination_file": null,
  "watch_paths": [
    "."
  ],
  "ignore_patterns": [
    ".git/*",
    ".orchestra/*",
    "node_modules/*",
    "__pycache__/*",
    "*.pyc",
    "*.log",
    "dist/*",
    "build/*"
  ],
  "debounce_ms": 500,
  "lock_lease_seconds": 1800,
  "git": {
    "enabled": true,
    "main_branch": "main",
    "sync_branches": [],
    "remote": "origin",
    "auto_commit": true,
    "auto_push": true,
    "commit_prefix": "chore(orchestra):"
  },
  "ci": {
    "enabled": false,
    "provider": "github_actions",
    "workflow_name": "ci.yml",
    "poll_interval_seconds": 15,
    "timeout_seconds": 600
  },
  "pipeline": {
    "verify_command": "python scripts/example_verifier.py",
    "pre_claim_command": null,
    "post_sync_command": "python scripts/example_notifier.py",
    "on_error_command": null
  }
}

